    "@unifor-quest/lang-typescript": "*",
    "@unifor-quest/lsp": "*",
    "@unifor-quest/runner": "*",
    "electron": "44.4.4",
    "electron-builder": "26.18.0",
    "electron-vite": "^5.0.0",
    "monaco-editor": "^0.56.0",
    "phaser": "^4.2.1",
    "vite": "^7.3.6"
