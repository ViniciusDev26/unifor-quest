{
  "name": "@unifor-quest/conformance",
  "version": "0.0.0",
  "private": true,
  "description": "The suite every language adapter must pass before it enters the game",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@unifor-quest/core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@unifor-quest/lang-go": "*",
    "@unifor-quest/lang-java": "*",
    "@unifor-quest/lang-python": "*",
    "@unifor-quest/lang-typescript": "*",
    "@unifor-quest/runner": "*"
  }
}
